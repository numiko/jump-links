{
  "name": "@numiko/jump-links",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "release": "release-it"
  },
  "main": "./dist/jumplinks.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/jumplinks.d.ts",
      "import": "./dist/jumplinks.es.js",
      "require": "./dist/jumplinks.umd.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/numiko/jump-links.git"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.6.2",
    "@vitest/coverage-v8": "^2.0.4",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "happy-dom": "^14.12.3",
    "release-it": "^17.10.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.0.4"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run build"
      ]
    }
  }
}
